  "components": {
    
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },

    "schemas": {

      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-14T12:00:00Z"
          }
        }
      },

      "CreateSessionRequest": {
        "type": "object",
        "required": ["login", "pass"],
        "properties": {
          "login": { "type": "string", "example": "admin" },
          "pass": { "type": "string", "example": "password123" }
        }
      },

      "Pluviometer": {
        "type": "object",
        "properties": {
          "uuidpluvi": { "type": "string", "format": "uuid" },
          "idpluvi": { "type": "integer", "format": "int64" },
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "nserie": { "type": "string" },
          "_lat": { "type": "string" },
          "_long": { "type": "string" },
          "value": { "type": "number", "format": "float" },
          "status_at": { "type": "boolean", "description": "Status real persistido no banco"},
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },

      "CreatePluviometerRequest": {
        "type": "object",
        "required": ["idpluvi", "nome", "nserie", "_lat", "_long", "status_at"],
        "properties": {
          "idpluvi": { "type": "integer", "example": 123 },
          "nome": { "type": "string", "example": "PLV-2026-001" },
          "nserie": { "type": "string", "example": "123-1" },
          "descricao": { "type": "string", "example": "Pluviômetro Central" },
          "_lat": { "type": "string", "example": "-23.5505" },
          "_long": { "type": "string", "example": "-46.6333" },
          "status_at": { "type": "boolean", "example": true }
        }
      },

      "UpdatePluviometerRequest": {
        "type": "object",
        "required": ["uuidpluvi", "idpluvi", "nome", "nserie", "_lat", "_long", "status_at"],
        "properties": {
          "uuidpluvi": { "type": "string", "format": "uuid" },
          "idpluvi": { "type": "integer", "example": 123 },
          "nome": { "type": "string", "example": "PLV-2026-001" },
          "nserie": { "type": "string", "example": "123-1" },
          "descricao": { "type": "string", "example": "Pluviômetro Central" },
          "_lat": { "type": "string", "example": "-23.5505" },
          "_long": { "type": "string", "example": "-46.6333" },
          "status_at": { "type": "boolean", "example": true }
        }
      },

