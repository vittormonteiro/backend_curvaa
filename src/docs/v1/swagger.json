{

  "openapi": "3.0.0",

  "info": {
    "title": "API REST - SISTEMA CURVAA",
    "version": "1.0.0",
    "description": "## Descrição\n\nAPI REST responsável por gerenciar os dados de do sistema CURVAA.\n\n### 🔐 Autenticação\nEsta API utiliza **Bearer Token (JWT)**.\n\nUse o botão **Authorize** e informe:\n\n```\nBearer {seu_token_jwt}\n```",
    "contact": {
      "name": "Vitor Monteiro",
      "email": "vitor.lmj@gmail.com"
    }
  },

  "servers": [
    {
      "url": "http://localhost:5433",
      "description": "Ambiente de Desenvolvimento"
    },
    {
      "url": "http://curvaa.com.br/api",
      "description": "Ambiente de Produção"
    }
  ],

  "security": [
    { "bearerAuth": [] }
  ],

  "tags": [
    { "name": "Health", "description": "Monitoramento da API" },
    { "name": "Session", "description": "Criar ou remover sessão (token)" },
    { "name": "Pluviometers", "description": "Gestão e consulta dos pluviômetros" },
    { "name": "Pluviometers Data", "description": "Gestão e consulta dos dados dos pluviômetros" },
    { "name": "Precipitation", "description": "Gestão e consulta dos dados de precipitação (Clima tempo)" },
    { "name": "Sector", "description": "Gestão e consulta dos setores" },
    { "name": "AlertsData", "description": "Consulta dos alertas enviados por email" },
    { "name": "Users", "description": "Gestão e consulta dos usuários" },
    { "name": "Profile", "description": "Gestão e consulta do perfil do usuário" }
  ],

  "paths": {

    "/": {

      "get": {
        "tags": ["Health"],
        "summary": "Verificar status da API",
        "operationId": "healthCheck",
        "security": [],
        "responses": {
          "200": {
            "description": "API disponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },

    "/session": {

