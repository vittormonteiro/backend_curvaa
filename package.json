  "scripts": {
    "build": "tsc && npm run copy-files",
    "copy-files": "copyfiles -u 1 \"src/**/*.hbs\" \"src/**/*.html\" dist/",
    "lint": "npx eslint --config eslint.config.mjs .",
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch node_modules --inspect -r tsconfig-paths/register src/shared/infra/http/server.ts",
    "start": "node -r tsconfig-paths/register dist/shared/infra/http/server.js",
    "pm2": "pm2 start dist/shared/infra/http/server.js --node-args='-r tsconfig-paths/register' --name backend-curvaa",
    "typeorm": "typeorm-ts-node-commonjs -d ./src/shared/infra/typeorm/data-source.ts",
    "lint-fix": "eslint --config eslint.config.mjs . --fix",
    "test": "jest",
    "git:commit": "node scripts/git-commit.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^27.5.2",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/bcryptjs": "^2.4.2",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.1",
    "jest": "^28.1.3",
    "ts-jest": "^28.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^1.1.8",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "celebrate": "^12.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "handlebars": "^4.7.7",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.7.3",
    "reflect-metadata": "^0.1.14",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "lodash": "4.18.1"
  }
}
